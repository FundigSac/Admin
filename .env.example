# Copia este archivo a .env.local (local) o carga las variables en Vercel. Nunca subas valores reales.
#
# Sin estas variables el panel es la demostración: datos simulados en el navegador y acceso con la bandeja de prueba.
# Con ellas usa el Backend FUNDIGSAC (carpeta Backend/, Docker): acceso con el código que llega al correo (Mailpit en
# local: http://localhost:8025), cuentas reales, actividad y colas de atención.

# "backend" activa el Backend en el navegador (se fija al compilar).
NEXT_PUBLIC_DATA_SOURCE=
# API del Backend; solo la usa el servidor del panel (BFF). "self" = la API de este mismo proyecto (src/app/api/v1).
# Backend Java local con Docker: http://localhost:8080
BACKEND_URL=
# Secreto que firma las cookies de sesión (mínimo 32 caracteres). Generar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_AUTH_SECRET=

# --- API propia (/api/v1) sobre Supabase (proyecto fundigsac-admin, esquema app) ---
# Conexión del rol fundigsac_api por el pooler de transacciones (puerto 6543). Solo DML.
DATABASE_URL=
# Secreto que firma los tokens de acceso de la API (mínimo 32 caracteres).
API_JWT_SECRET=
# Correo transaccional (código de acceso, constancias y respuestas). Sin esto los correos quedan pendientes.
RESEND_API_KEY=
MAIL_FROM=
